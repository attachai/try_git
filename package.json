{
  "name": "family-reward-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply family-reward-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply family-reward-db --remote",
    "db:seed:local": "wrangler d1 execute family-reward-db --local --file=./db/seed/001_demo.sql",
    "db:seed:remote": "wrangler d1 execute family-reward-db --remote --file=./db/seed/001_demo.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.9.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260920.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.40.0"
  }
}
